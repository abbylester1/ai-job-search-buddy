# Mode: "hosted" (accounts + credits + Stripe) or "local" (single user, no limits)
APP_MODE=hosted

# Required for AI calls either way
ANTHROPIC_API_KEY=sk-ant-...

# Flask session signing (generate: python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=

# Hosted mode only
FREE_CREDITS=10
MAX_FREE_SIGNUPS_PER_IP_PER_DAY=3
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Required (not just cosmetic) if Stripe is enabled - checkout refuses to
# build a redirect URL without it, rather than trusting the request Host header.
PUBLIC_URL=https://yourdomain.example

# Optional
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
DATABASE_PATH=buddy.db
PORT=5050
